---
import Layout from '@/layouts/Layout.astro'

import imgReference from '../assets/cv/swirgielPauline_CV_FR.png';
import { translations, type Lang } from '../i18n/translations';

const t = translations["fr"];

---

<Layout>
	<h1 class='text-6xl mb-4 font-[family-name:var(--font-monsieur-la-doulaise)]'>CV</h1>
	<div class="button_wrapper">
		<a href="/Portfolio/swirgielPauline_CV_FR.pdf" download="swirgielPauline_CV_FR.pdf" class="download_button">
			<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
				<polyline points="7 10 12 15 17 10"/>
				<line x1="12" y1="15" x2="12" y2="3"/>
			</svg>
			<span> {t.cv.download} </span>
		</a>
	</div>

	<style>
		.button_wrapper {
			text-align: center;
		}
		
		.download_button {
			display: inline-flex;
			justify-content: center;
			align-items: center;
			gap: 0.5rem;
			padding: 0.75rem 1.5rem;
			max-width: 20dvh;
			background-color: #7e9bc9;
			color: white;
			border-radius: 0.5rem;
			text-decoration: none;
			font-weight: 600;
			font-size: 0.95rem;
			transition: background-color 0.2s ease, transform 0.15s ease;
		}

		.download_button:hover {
			background-color: #334155;
			transform: translateY(-1px);
		}

		.download_button svg {
			flex-shrink: 0;
		}
	</style>
	<br>
	<img src={imgReference.src} alt="swirgielPauline_CV_FR">
</Layout>