---
type Badge = {
	label: string
	imgUrl: string
}

type Category = {
	title: string
	badges: Badge[]
}

const categories: Category[] = [
	{
		title: 'Languages',
		badges: [
			{ label: 'Python', imgUrl: 'https://img.shields.io/badge/Python-3776AB?style=for-the-badge&logo=python&logoColor=fff' },
			{ label: 'TypeScript', imgUrl: 'https://img.shields.io/badge/TypeScript-3178C6?style=for-the-badge&logo=typescript&logoColor=fff' },
			{ label: 'JavaScript', imgUrl: 'https://img.shields.io/badge/JavaScript-F7DF1E?style=for-the-badge&logo=javascript&logoColor=000' },
			{ label: 'C', imgUrl: 'https://img.shields.io/badge/C-00599C?style=for-the-badge&logo=c&logoColor=white' },
			{ label: 'C++', imgUrl: 'https://img.shields.io/badge/C++-%2300599C.svg?style=for-the-badge&logo=c%2B%2B&logoColor=white' },
			{ label: 'Bash', imgUrl: 'https://img.shields.io/badge/Bash-4EAA25?style=for-the-badge&logo=gnubash&logoColor=fff' },
		],
	},
	{
		title: 'Front-end',
		badges: [
			{ label: 'React', imgUrl: 'https://img.shields.io/badge/React-%2320232a.svg?style=for-the-badge&logo=react&logoColor=%2361DAFB' },
			{ label: 'HTML', imgUrl: 'https://img.shields.io/badge/HTML-%23E34F26.svg?style=for-the-badge&logo=html5&logoColor=white' },
			{ label: 'CSS', imgUrl: 'https://img.shields.io/badge/CSS-639?style=for-the-badge&logo=css&logoColor=fff' },
			{ label: 'Tailwind CSS', imgUrl: 'https://img.shields.io/badge/Tailwind%20CSS-%2338B2AC.svg?style=for-the-badge&logo=tailwind-css&logoColor=white' },
		],
	},
	{
		title: 'Back-end',
		badges: [
			{ label: 'Node.js', imgUrl: 'https://img.shields.io/badge/Node.js-6DA55F?style=for-the-badge&logo=node.js&logoColor=white' },
			{ label: 'Express.js', imgUrl: 'https://img.shields.io/badge/Express.js-%23404d59.svg?style=for-the-badge&logo=express&logoColor=%2361DAFB' },
		],
	},
	{
		title: 'Databases',
		badges: [
			{ label: 'MySQL', imgUrl: 'https://img.shields.io/badge/MySQL-4479A1?style=for-the-badge&logo=mysql&logoColor=fff' },
			{ label: 'MariaDB', imgUrl: 'https://img.shields.io/badge/MariaDB-003545?style=for-the-badge&logo=mariadb&logoColor=white' },
			{ label: 'Postgres', imgUrl: 'https://img.shields.io/badge/Postgres-%23316192.svg?style=for-the-badge&logo=postgresql&logoColor=white' },
			{ label: 'SQLite', imgUrl: 'https://img.shields.io/badge/SQLite-%2307405e.svg?style=for-the-badge&logo=sqlite&logoColor=white' },
		],
	},
	{
		title: 'Tools',
		badges: [
			{ label: 'Git', imgUrl: 'https://img.shields.io/badge/Git-F05032?style=for-the-badge&logo=git&logoColor=fff' },
			{ label: 'GitHub', imgUrl: 'https://img.shields.io/badge/GitHub-%23121011.svg?style=for-the-badge&logo=github&logoColor=white' },
			{ label: 'Vite', imgUrl: 'https://img.shields.io/badge/Vite-646CFF?style=for-the-badge&logo=vite&logoColor=fff' },
			{ label: 'npm', imgUrl: 'https://img.shields.io/badge/npm-CB3837?style=for-the-badge&logo=npm&logoColor=fff' },
			{ label: 'Docker', imgUrl: 'https://img.shields.io/badge/Docker-2496ED?style=for-the-badge&logo=docker&logoColor=fff' },
		],
	},
]
---

<div class='flex flex-col gap-6'>
	{categories.map((category) => (
		<div>
			<h3 class='text-sm font-semibold uppercase tracking-wide text-base-content/60 mb-2'>
				{category.title}
			</h3>
			<div class='flex flex-wrap gap-2'>
				{category.badges.map((badge) => (
					<img src={badge.imgUrl} alt={badge.label} class='h-7' loading='lazy' />
				))}
			</div>
		</div>
	))}
</div>