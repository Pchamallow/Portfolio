---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets'
import { translations, type Lang } from '../../i18n/translations';
import SocialIcons from './SocialIcons.astro';

interface Props {
	lang: Lang;
	fullName: string;
	title: string;
	institute?: string;
	profilePicture: ImageMetadata; 
}
const { lang, fullName, profilePicture } = Astro.props;
const t = translations[lang].hero;
---
<div class='flex-1'>
	<h1 class='text-6xl mb-4 font-[family-name:var(--font-monsieur-la-doulaise)]'>
		{t.welcome}
	</h1>
	<h1 class='text-6xl mb-6 font-[family-name:var(--font-monsieur-la-doulaise)]'>
		{t.imTitle} <span class='text-secondary'>{fullName}</span>
	</h1>
	<p class='text-2xl font-bold mb-9 font-[family-name:var(--font-playfair-display)]'>
		{t.role}
	</p>
	<p class='text-xl font-bold mb-2 font-[family-name:var(--font-manrope)]'>
		{t.aboutMeLabel} <br>
	</p>
	<p class='text-xl mb-5 font-[family-name:var(--font-manrope)]'>
		{t.aboutMeText.map((line) => <>{line}<br/></>)}
	</p>
	<p class="availability-badge text-xl font-bold italic mb-2 font-[family-name:var(--font-manrope)]">
		{t.availability}
	</p>
	<div class='flex gap-4 mb-6'>
		<SocialIcons />
	</div>
	<p class='text-xl font-bold mb-2 font-[family-name:var(--font-manrope)]'>
		{t.onSiteLabel}
	</p>
	<p class='text-xl mb-6 font-[family-name:var(--font-manrope)]'>
		{t.onSiteText}
	</p>
</div>
<div class='size-72 lg:block hidden'>
	<!-- Add your profile image -->
	<Image
		src={profilePicture}
		alt={fullName}
		class='w-full h-full mask mask-circle size-44'
	/>
</div>
